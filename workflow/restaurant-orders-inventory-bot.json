    {
      "parameters": {
        "jsCode": "// جلب نص الرسالة القادمة من التليجرام\nconst message = $input.first().json.message?.text || \"\";\n\n// تقسيم النص للحصول على اسم المكون والكمية الجديدة (مثال: update Burger 50)\nconst parts = message.trim().split(/\\s+/);\n\nconst itemName = parts[1] || \"\";\nconst newQuantity = Number(parts[2]) || 0;\n\nreturn {\n  json: {\n    item_name: itemName,\n    new_quantity: newQuantity,\n    chat_id: $input.first().json.message?.chat?.id\n  }\n};"
      },
