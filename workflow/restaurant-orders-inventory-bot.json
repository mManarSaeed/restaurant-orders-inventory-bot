      "id": "9b3d3305-ea20-48b6-b3cc-a651a4520111",
      "name": "Get row(s) in sheet1"
    },
    {
      "parameters": {
        "jsCode": "// 1. جلب مكونات الوجبة من نود Get row(s) in sheet1\nconst recipeItems = $(\"Get row(s) in sheet1\").all();\n\n// 2. جلب جميع عناصر المخزون من نود GetAllStock\nconst allStock = $input.all();\n\nconst LOW_STOCK_THRESHOLD = 5;\n\n// 3. الخصم فقط للمكونات المطلوبة في الوجبة وفحص نقص المخزون\nreturn recipeItems.map(item => {\n  const itemName = item.json.Required_Item;\n  const qtyUsed = Number(item.json.Qty_Per_Meal) || 1;\n\n  // البحث عن المكون المطابق داخل شيت الـ Stock\n  const stockMatch = allStock.find(row => row.json.Item_Name === itemName);\n  const currentQty = stockMatch ? Number(stockMatch.json.Quantity || 0) : 0;\n\n  // حساب الكمية الجديدة بعد الخصم\n  const newQty = Math.max(0, currentQty - qtyUsed);\n\n  // فحص هل الكمية أقل من الحد الأدنى\n  const isLowStock = newQty < LOW_STOCK_THRESHOLD;\n\n  return {\n    json: {\n      item_name: itemName,\n      new_quantity: newQty,\n      is_low_stock: isLowStock,\n      low_stock_threshold: LOW_STOCK_THRESHOLD\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2016,
        304
      ],
      "id": "d3d85ca6-71d4-4903-bb88-5e3ffba6111d",
      "name": "Code in JavaScript2"
    },
