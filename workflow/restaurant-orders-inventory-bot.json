    {
      "parameters": {
        "jsCode": "// 1. استخراج رقم الطلب من الزر المكبوس\nconst callbackData = $(\"Telegram Trigger\").first().json.callback_query?.data || \"\";\nconst orderId = callbackData.replace(\"done_\", \"\").trim();\n\n// 2. قراءة الحالة الحالية للطلب القادمة من نود جلب الشيت\nconst orderRow = $(\"Get row(s) in sheet5\").first().json;\nconst currentStatus = String(orderRow.Status || \"\").trim().toLowerCase();\n\nlet isAlreadyProcessed = false;\nlet message = \"\";\n\nif (currentStatus === \"done\" || currentStatus === \"completed\") {\n  isAlreadyProcessed = true;\n  message = \"⚠️ هذا الطلب تم إتمامه ومعالجته بالفعل مسبقاً!\";\n} else if (currentStatus === \"canceled\") {\n  isAlreadyProcessed = true;\n  message = \"❌ لا يمكن إتمام هذا الطلب لأنه ملغى!\";\n}\n\nreturn {\n  json: {\n    order_id: orderId,\n    is_processed: isAlreadyProcessed,\n    status_message: message\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        400
      ],
