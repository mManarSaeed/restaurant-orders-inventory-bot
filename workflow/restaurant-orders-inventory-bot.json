    {
      "parameters": {
        "jsCode": "// جلب المكونات من نود Get row(s) in sheet2\nconst recipeItems = $(\"Get row(s) in sheet2\").all();\nconst allStock = $(\"Get Stock For Order\").all();\n\nlet canPrepare = true;\nlet missingItems = [];\nlet mealPrice = 0;\n\nrecipeItems.forEach(item => {\n  const itemName = String(item.json.Required_Item || \"\").trim();\n  const qtyNeeded = Number(item.json.Qty_Per_Meal) || 1;\n  \n  // حفظ سعر الوجبة من العمود الجديد Meal_Price\n  if (item.json.Meal_Price) {\n    mealPrice = Number(item.json.Meal_Price);\n  }\n\n  const stockMatch = allStock.find(row => \n    String(row.json.Item_Name || \"\").trim().toLowerCase() === itemName.toLowerCase()\n  );\n\n  const availableQty = stockMatch ? Number(stockMatch.json.Quantity || 0) : 0;\n\n  if (availableQty < qtyNeeded) {\n    canPrepare = false;\n    missingItems.push(itemName);\n  }\n});\n\nreturn {\n  json: {\n    can_prepare: canPrepare,\n    meal_price: mealPrice,\n    missing_items: missingItems.join(\", \")\n  }\n};"
      },
