    {
      "parameters": {
        "jsCode": "// 1. جلب الطلبات والمخزون\nconst allOrders = $(\"Get row(s) in sheet3\").all();\nconst allStock = $(\"Get Stock For Report\").all();\nconst todayStr = new Date().toISOString().split('T')[0];\n\nlet totalOrders = 0;\nlet completedOrders = 0;\nlet canceledOrders = 0;\nlet totalRevenue = 0;\nconst mealCounts = {};\n\n// 2. تحليل الطلبات المضافة اليوم فقط (بناءً على وجود السعر المكتوب حديثاً Total_Price)\nallOrders.forEach(row => {\n  const status = String(row.json.Status || \"\").trim().toLowerCase();\n  const mealName = String(row.json.Items_Ordered || \"\").replace(\"order \", \"\").trim();\n  const price = Number(row.json.Total_Price || 0);\n\n  // الفلترة: نحسب الطلبات الحديثة التي تم تسجيل سعرها الإجمالي (Total_Price > 0)\n  if (price > 0 || row.json.Order_ID?.startsWith(\"ORD-07\")) {\n    totalOrders++;\n\n    if (status === \"done\" || status === \"completed\") {\n      completedOrders++;\n      totalRevenue += price;\n\n      if (mealName) {\n        mealCounts[mealName] = (mealCounts[mealName] || 0) + 1;\n      }\n    } else if (status === \"canceled\") {\n      canceledOrders++;\n    }\n  }\n});\n\n// 3. تحديد الوجبة الأكثر مبيعاً لليوم (Best Seller)\nlet bestSeller = \"لا يوجد مبيعات اليوم\";\nlet maxCount = 0;\n\nfor (const [meal, count] of Object.entries(mealCounts)) {\n  if (count > maxCount) {\n    maxCount = count;\n    bestSeller = `${meal} (${count} مرات)`;\n  }\n}\n\n// 4. حصر المكونات المنخفضة بالمخزون (أقل من 5 قطع)\nconst lowStockItems = allStock\n  .filter(row => Number(row.json.Quantity || 0) < 5)\n  .map(row => `${row.json.Item_Name}: متبقي ${row.json.Quantity}`)\n  .join(\"\\n- \") || \"جميع المكونات متوفرة بنسبة جيدة\";\n\nreturn {\n  json: {\n    report_date: todayStr,\n    total_orders: totalOrders,\n    completed_orders: completedOrders,\n    canceled_orders: canceledOrders,\n    total_revenue: totalRevenue,\n    best_seller: bestSeller,\n    low_stock: lowStockItems\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        1104
      ],
      "id": "6fb5d36d-afe6-4db0-a2c4-60b35f49ca16",
      "name": "Code in JavaScript4"
    },
